{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32F103C8T6 - ST-Link",
            "cwd": "${workspaceFolder}",

            "preBuild": "${command:st-stm32-ide-debug-launch.build}",

            "deviceName": "STM32F103C8Tx",
            "deviceCore": "Cortex-M3",
            "deviceTrustzone": "TZ-disabled",

            "program": "${workspaceFolder}/build/Debug/OLED_Test.elf",

            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/Debug/OLED_Test.elf",
                    "symbolFileName": "${workspaceFolder}/build/Debug/OLED_Test.elf"
                }
            ],

            "serverInterface": "SWD",
            "serverInterfaceFrequency": "1000",
            "runEntry": "main"
        }
    ]
}